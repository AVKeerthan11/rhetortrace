  },
  "regions": [
    {
      "region_idx": 0,
      "first_idx": 0,
      "last_idx": 43,
      "text": "The feeling of the nation must be quickened; the conscience of the nation must be roused; the propriety of the nation must be startled; the hypocrisy of the nation must be exposed; and its crimes against God and man must be proclaimed and denounced.",
      "n_words": 44,
      "n_aligned": 44,
      "start": 0.84,
      "end": 16.045,
      "speech_rate_wps": 2.894,
      "articulation_rate_wps": 4.279
    },
    {
      "region_idx": 1,
      "first_idx": 44,
      "last_idx": 53,
      "text": "What, to the American slave, is your Fourth of July?",
      "n_words": 10,
      "n_aligned": 10,
      "start": 16.625,
      "end": 19.426,
      "speech_rate_wps": 3.57,
      "articulation_rate_wps": 4.673
    },
    {
      "region_idx": 2,
      "first_idx": 54,
      "last_idx": 81,
      "text": "I answer; a day that reveals to him, more than all other days in the year, the gross injustice and cruelty to which he is the constant victim.",
      "n_words": 28,
      "n_aligned": 28,
      "start": 19.906,
      "end": 28.889,
      "speech_rate_wps": 3.117,
      "articulation_rate_wps": 4.633
    },
    {
      "region_idx": 3,
      "first_idx": 82,
      "last_idx": 121,
      "text": "To him your celebration is a sham; your boasted liberty, an unholy license; your national greatness, swelling vanity; your sounds of rejoicing are empty and heartless; your denunciations of tyrants, brass-fronted impudence; your shouts of liberty and equality, hollow mockery.",
      "n_words": 40,
      "n_aligned": 40,
      "start": 29.409,
      "end": 49.435,
      "speech_rate_wps": 1.997,
      "articulation_rate_wps": 3.062
    }
  ],
  "summary": {
    "n_words": 122,
    "failures": {}
  },
